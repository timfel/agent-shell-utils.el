;;; Commentary:

;; Launch agents through nono only.  No systemd-run, no bubblewrap.
;;
;; Instead of relying on globally installed nono profile files, each
;; agent buffer gets a generated JSON profile (written under
;; `agent-shell-nono-generated-profile-directory') on every launch.
;; The profile extends nono's built-in `default' profile and is
;; assembled from the customizations below.
;;
;; Resource limits are enforced by nono itself via cgroup v2 (Linux):
;;
;;   * Memory: `agent-shell-nono-memory-limit-gb' is passed to nono as
;;     --memory.  nono refuses to run rather than leave a requested
;;     limit unenforced.
;;   * Process count: `agent-shell-nono-max-processes' maps to
;;     nono's --max-processes.  Note: nono has no CPU-quota facility
;;     (no equivalent of systemd's CPUQuota exists in nono), so CPU
;;     throttling is not available; the process-count cap is the only
;;     CPU-adjacent control nono enforces.
;;
;; Filesystem policy grants read-only access to system-wide tool
;; locations (`agent-shell-nono-system-read-paths': /usr, /bin, /etc
;; and friends) so system-installed compilers and tools work.
;; Restrictions apply only where escape risk justifies it:
;; socket-bearing runtime directories (/run, /var/run) stay ungranted
;; except for the specific sockets listed below.  X11 is neutralized
;; through the environment (`agent-shell-nono-block-x11'): DISPLAY and
;; XAUTHORITY are redirected so keyloggers and xdotool cannot reach
;; the real X server, and X11 cookies are never granted.  (Landlock
;; cannot deny /tmp/.X11-unix inside the allowed /tmp, so path denies
;; alone could not achieve this.)  Wayland stays usable:
;; $XDG_RUNTIME_DIR/wayland-* is granted as a Unix socket and
;; `agent-shell-nono-allow-gpu' opens render nodes, so graphical
;; (Wayland) applications work.
;;
;; On native Linux, capability elevation is enabled.  File accesses
;; outside the generated grant set are escalated to Emacs instead of a
;; terminal prompt: nono's supervisor POSTs each request to a tiny
;; loopback HTTP server implemented in this file, which surfaces a
;; yes/no approval prompt scoped to the owning agent-shell buffer.
;; Answering `a' additionally adds the path to the generated profile,
;; so subsequent launches of that agent session include it directly.

;;; Code:

(require 'agent-shell)
(require 'agent-shell-utils)
(require 'subr-x)
(require 'json)
(require 'cl-lib)

;;; Customization.

(defcustom agent-shell-nono-enabled t
  "When non-nil, sandbox agent processes with nono.
Missing nono is an error.  Explicitly setting this to nil launches
agents completely unsandboxed."
  :type 'boolean
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-generated-profile-directory
  (expand-file-name "nono/generated/" user-emacs-directory)
  "Directory for per-session nono profiles generated by Emacs.
Files here are rewritten on every agent launch and pruned when agent
buffers die or Emacs restarts."
  :type 'directory
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-memory-limit-gb 32
  "Maximum memory, in GiB, passed to nono via --memory.
The effective cap is the smaller of this value and
`agent-shell-nono-memory-fraction' of total host memory.  Linux only;
nil disables the memory cap."
  :type '(choice (const :tag "No limit" nil) integer)
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-memory-fraction 0.8
  "Fraction of host memory the sandbox may at most consume."
  :type 'number
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-max-processes 2
  "Task (process + thread) cap passed to nono via --max-processes.
At the cap the kernel refuses new forks instead of killing the sandbox.
nono has no CPU-quota facility; this is its process-side resource cap.
nil disables the limit."
  :type '(choice (const :tag "No limit" nil) integer)
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-capability-elevation t
  "When non-nil, enable nono capability elevation on native Linux.
With elevation enabled, file accesses outside the generated grant set
are intercepted by nono's supervisor and routed to the Emacs approval
prompt implemented in this file.  Without it the sandbox is static and
denials are silent.  Unavailable on macOS and WSL2."
  :type 'boolean
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-approval-timeout-secs 300
  "Seconds nono's supervisor waits for an Emacs approval answer.
nono denies the request when its own timeout expires."
  :type 'integer
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-allow-gpu t
  "When non-nil, allow GPU/render-node access (needed by Wayland GUI apps)."
  :type 'boolean
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-network-block nil
  "When non-nil, block all outbound network access from agents."
  :type 'boolean
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-allow-domains nil
  "Optional list of domains for the nono proxy allowlist.
When non-nil, outbound traffic is proxy-filtered and only these domains
are reachable (e.g. \"github.com\" or \"https://github.com/org/**\")."
  :type '(repeat string)
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-ssh-agent t
  "When non-nil, native Linux launches get a host-managed SSH agent.
The agent socket lives under XDG_RUNTIME_DIR, outside the sandbox, and
is granted to the agent as a single Unix socket together with
SSH_AUTH_SOCK and a destination-unconstrained, batch-mode
GIT_SSH_COMMAND."
  :type 'boolean
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-reuse-existing-ssh-agent t
  "When non-nil, reuse a reachable SSH agent with loaded identities.
An agent already configured via SSH_AUTH_SOCK with at least one
identity is granted to the sandbox directly.  Otherwise a dedicated
Emacs-managed agent is started under XDG_RUNTIME_DIR."
  :type 'boolean
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-ssh-agent-keys '("~/.ssh/id_ed25519")
  "Private key files to load on the host when the managed SSH agent is empty.
Keys are not destination-constrained: sandboxed clients can authenticate
anywhere a loaded key is accepted.  Private-key files need not be readable
inside the sandbox.  Set nil to load keys manually with ssh-add instead.
Encrypted keys must be unlocked on the host; startup never prompts for a
passphrase on the agent's ACP connection."
  :type '(repeat file)
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-system-read-paths
  '("/usr" "/bin" "/sbin" "/lib" "/lib64" "/usr/local" "/etc" "/opt"
    "/nix/store")
  "System-wide directories granted read-only so system tools work.
This keeps system-installed compilers, linkers and utilities usable.
Socket-bearing runtime directories (/run, /var/run) are deliberately
absent: service sockets there (systemd, D-Bus, dbus-broker, ...) are
escape paths and are not granted."
  :type '(repeat string)
  :group 'agent-shell-utils)

