  "Single files granted read-only in generated nono profiles.
nono's default deny groups block shell dotfiles; the grants in this
variable plus `agent-shell-nono-bypass-protection-paths' reopen them."
  :type '(repeat string)
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-bypass-protection-paths
  '("$HOME/.ssh/known_hosts" "$HOME/.bashrc" "$HOME/.bash_profile")
  "Default deny rules to lift for the read grants above.
`bypass_protection' only removes the matching deny rule; access still
needs a matching grant in one of the read lists."
  :type '(repeat string)
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-block-x11 t
  "When non-nil, neutralize X11 inside the sandbox via the environment.
Landlock cannot deny paths inside an allowed directory, so while /tmp
stays writable the DISPLAY/X11 socket itself is not revocable that way.
Generated profiles therefore inject DISPLAY pointing at a host name
that never resolves plus XAUTHORITY=/dev/null: Xlib clients (xdotool,
keyloggers) fail to open the real display.  X11 cookies in
~/.Xauthority are never granted either.  Wayland is unaffected."
  :type 'boolean
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-extra-deny-paths
  '("/root" "$HOME/.config/mc" "$HOME/.config/onedrive"
    "$HOME/.config/pulse" "$HOME/.config/rclone")
  "Paths explicitly denied in generated profiles even when readable.
Only rules that do not overlap an allowed parent belong here: Landlock
cannot express a deny inside an allowed parent, and nono refuses to
start on conflicting policy.  /etc/shadow and friends are deliberately
absent \u2014 they are mode 000/0400 root-owned files, so unprivileged
reads already fail at the kernel level."
  :type '(repeat string)
  :group 'agent-shell-utils)

(defcustom agent-shell-nono-wayland-sockets '("wayland-0" "wayland-1")
  "Socket names under $XDG_RUNTIME_DIR granted for Wayland display access."
  :type '(repeat string)
  :group 'agent-shell-utils)

;;; Internal state.

(defvar agent-shell-nono--previous-command-prefix nil)
(defvar agent-shell-nono--ssh-agent-process nil
  "SSH-agent process started by this Emacs, if any.")
(defvar agent-shell-nono--wsl-p 'unset
  "Cached WSL2 detection result.")
(defvar agent-shell-nono--launch-counter 0
  "Counter used to name generated profiles.")
(defvar agent-shell-nono--approval-server nil
  "Loopback HTTP server process for nono approval webhooks.")
(defvar agent-shell-nono--approval-port nil
  "TCP port of the approval webhook server.")
(defvar agent-shell-nono--approval-sessions (make-hash-table :test 'equal)
  "Map of per-session URL token to agent-shell buffer.")
(defvar agent-shell-nono--approval-queue nil
  "Queue of pending approval request entries.")
(defvar agent-shell-nono--approval-active nil
  "The entry currently being answered in the minibuffer, or nil.")

(defvar-local agent-shell-nono--session-token nil
  "Secret URL token authenticating this session's approval callbacks.")
(defvar-local agent-shell-nono--session-profile-file nil
  "Generated nono profile file last used for this agent buffer.")
(defvar-local agent-shell-nono--remembered-approvals nil
  "Alist of (PATH . ACCESS) approvals remembered for this session.
Included in the generated profile on subsequent launches.")

;;; Platform helpers.

(defun agent-shell-nono--wsl-p ()
  "Return non-nil when running under WSL2."
  (if (eq agent-shell-nono--wsl-p 'unset)
      (setq agent-shell-nono--wsl-p
            (and (eq system-type 'gnu/linux)
                 (ignore-errors
                   (with-temp-buffer
                     (insert-file-contents "/proc/version")
                     (let ((case-fold-search t))
                       (and (search-backward "microsoft" nil t) t))))))
    agent-shell-nono--wsl-p))

(defun agent-shell-nono--native-linux-p ()
  "True when the full nono Linux feature set applies (native Linux)."
  (and (eq system-type 'gnu/linux) (not (agent-shell-nono--wsl-p))))

(defun agent-shell-nono--elevation-available-p ()
  "True when capability elevation plus webhook approvals should be used."
  (and agent-shell-nono-capability-elevation
       (agent-shell-nono--native-linux-p)))

(defun agent-shell-nono--memory-arg ()
  "Return a --memory size string such as \"12G\", or nil."
  (when-let* ((limit agent-shell-nono-memory-limit-gb)
              (total-kib (ignore-errors (car (memory-info))))
              (total-gib (/ total-kib 1024.0 1024.0))
              (capped (max 1 (min limit
                                  (floor (* agent-shell-nono-memory-fraction
                                            total-gib))))))
    (format "%dG" capped)))

;;; Managed SSH agent (host side, outside the sandbox).

(defun agent-shell-nono--ssh-agent-socket ()
  "Return the managed socket path, checking its private runtime directory."
  (let* ((runtime (getenv "XDG_RUNTIME_DIR"))
         (directory (and runtime (expand-file-name "agent-shell-ssh" runtime))))
    (unless (and runtime (file-name-absolute-p runtime)
                 (file-directory-p runtime)
                 (not (file-remote-p runtime))
                 (not (string-prefix-p "/tmp/" (file-name-as-directory
                                                (file-truename runtime)))))
      (user-error "Managed SSH agent needs XDG_RUNTIME_DIR outside /tmp"))
    (dolist (path (list runtime directory))
      (unless (file-exists-p path)
        (make-directory path)
        (set-file-modes path #o700))
      (let ((attrs (file-attributes path)))
        (unless (and (eq t (file-attribute-type attrs))
                     (eql (file-attribute-user-id attrs) (user-uid))
                     (zerop (logand #o077 (file-modes path))))
          (user-error "SSH-agent directory must be owned by you with mode 0700: %s" path))))
    (expand-file-name "agent.sock" directory)))

(defun agent-shell-nono--ssh-agent-status (ssh-add)
  "Probe the current SSH_AUTH_SOCK with SSH-ADD.
Return 0 for loaded identities, 1 for an empty agent, or 2 if unreachable."
  (call-process ssh-add nil nil nil "-l"))

(defun agent-shell-nono--ensure-ssh-agent ()
  "Start or reuse a host SSH agent and load keys if it is empty.
The socket lives outside the sandbox policy.  A reachable agent
already configured in the environment is reused as-is; otherwise a
dedicated Emacs-managed agent is started.  The process started here
belongs to Emacs, not to an agent sandbox or systemd service."
  (cl-block agent-shell-nono--ensure-ssh-agent
  (let ((default-directory (expand-file-name "~/")))
    ;; Reuse an existing agent that is reachable and has identities.
    (when (and agent-shell-nono-reuse-existing-ssh-agent
               (getenv "SSH_AUTH_SOCK")
               (executable-find "ssh-add")
               (eq 0 (agent-shell-nono--ssh-agent-status "ssh-add")))
      (cl-return-from agent-shell-nono--ensure-ssh-agent
        (getenv "SSH_AUTH_SOCK"))))
  (let* ((socket (agent-shell-nono--ssh-agent-socket))
         ;; Do not resolve or run SSH tools in an untrusted workspace.
         (default-directory (expand-file-name "~/"))
         (ssh-add (or (executable-find "ssh-add")
                      (user-error "OpenSSH ssh-add is required")))
         (process-environment (copy-sequence process-environment)))
    (setenv "SSH_AUTH_SOCK" socket)
    ;; Force a noninteractive refusal even when Emacs has a controlling TTY.
    (setenv "SSH_ASKPASS_REQUIRE" "force")
    (setenv "SSH_ASKPASS" "/bin/false")
    (let ((status (agent-shell-nono--ssh-agent-status ssh-add)))
      (unless (memq status '(0 1))
        ;; Never replace an unexpected file, symlink, or unresponsive agent.
        (when (or (file-exists-p socket) (file-symlink-p socket))
          (user-error "SSH-agent socket is unresponsive; inspect/remove it on the host: %s" socket))
        (let ((ssh-agent (or (executable-find "ssh-agent")
                             (user-error "OpenSSH ssh-agent is required")))
              process ready)
          (with-temp-buffer
            (unwind-protect
                (progn
                  (setq process (make-process
                                 :name "agent-shell-ssh-agent" :buffer (current-buffer)
                                 :command (list ssh-agent "-D" "-a" socket "-P" "")
                                 :connection-type 'pipe :noquery t :sentinel #'ignore))
                  (let ((deadline (+ (float-time) 3)))
                    (while (and (process-live-p process)
                                (not (memq status '(0 1)))
                                (< (float-time) deadline))
                      (accept-process-output process 0.05)
                      (setq status (agent-shell-nono--ssh-agent-status ssh-add))))
                  (unless (memq status '(0 1))
                    (user-error "Could not start SSH agent: %s" (string-trim (buffer-string))))
                  ;; Killing the startup log buffer must not kill the agent.
                  (set-process-buffer process nil)
                  (setq ready t
                        agent-shell-nono--ssh-agent-process process))
              (unless ready
                (when (and process (process-live-p process))
                  (delete-process process)))))))
      (when (and (eq status 1) agent-shell-nono-ssh-agent-keys)
        (with-temp-buffer
          (unless (eq 0 (apply #'call-process ssh-add nil (current-buffer) nil
                               (mapcar #'expand-file-name agent-shell-nono-ssh-agent-keys)))
            (user-error "Could not load SSH keys (%s).  Unlock on the host with SSH_AUTH_SOCK=%s ssh-add, or customize agent-shell-nono-ssh-agent-keys"
                        (string-trim (buffer-string)) (shell-quote-argument socket))))))
    socket)))

;;; Approval webhook server.
;;
;; nono's supervisor POSTs {"backend": ..., "request": {...}} to the
;; webhook URL named in the generated profile and expects
;; {"decision":"grant"} or {"decision":"deny"}.  The callback URL
;; carries a per-session random token so that sandboxed processes which
;; happen to reach the loopback port cannot forge approvals: only
;; Emacs and nono's supervisor know the token.

(defun agent-shell-nono--session-token-ensure ()
  "Return (creating if needed) this session's secret callback token."
  (or agent-shell-nono--session-token
      (let ((token (format "%08x%08x%08x"
                           (random #x10000000)
                           (random #x10000000)
                           (logand (floor (* (float-time) 1000)) #xfffffff))))
        (setq agent-shell-nono--session-token token)
        (puthash token (current-buffer) agent-shell-nono--approval-sessions)
        token)))

(defun agent-shell-nono--approval-server ()
  "Start the loopback approval webhook server if needed; return its port."
  (if (and agent-shell-nono--approval-server
           (process-live-p agent-shell-nono--approval-server))
      agent-shell-nono--approval-port
    (let ((port nil)
          (attempt 0))
      (while (and (null port) (< attempt 25))
        (setq attempt (1+ attempt))
        (condition-case nil
            (let* ((candidate (+ 20000 (random 40000)))
                   (server (make-network-process
                            :name "agent-shell-nono-approval"
                            :family 'ipv4
                            :host "127.0.0.1"
                            :service candidate
                            :server t
                            :noquery t
                            :filter #'agent-shell-nono--approval-filter
                            :log #'ignore)))
              (setq agent-shell-nono--approval-server server
                    port (process-contact server :service)))
          (error nil)))
      (unless port
        (user-error "Could not bind the agent-shell-nono approval server"))
      (setq agent-shell-nono--approval-port port)
      port)))

(defun agent-shell-nono--approval-filter (connection string)
  "Process filter for one approval webhook CONNECTION receiving STRING."
  (let ((pending (concat (process-get connection 'pending) string)))
    (process-put connection 'pending pending)
    (let ((separator (string-search "\r\n\r\n" pending)))
      (when separator
        (let* ((head (substring pending 0 separator))
               (head-down (downcase head))
               (content-length
                (and (string-match "content-length: \\([0-9]+\\)" head-down)
                     (string-to-number (match-string 1 head-down))))
               (body-start (+ separator 4)))
          (when (and content-length
                     (>= (length pending) (+ body-start content-length)))
            (let ((body (substring pending body-start
                                   (+ body-start content-length))))
              (process-put connection 'pending
                           (substring pending (+ body-start content-length)))
              (agent-shell-nono--approval-dispatch connection head body))))))))

(defun agent-shell-nono--approval-dispatch (connection head body)
  "Route one parsed approval request: HEAD headers, BODY JSON."
  (let* ((request-line (car (split-string head "\r\n" t)))
         (token
          (save-match-data
            (when (string-match "\\`POST +/approve/\\([0-9a-f]+\\) HTTP"
                                request-line)
              (match-string 1 request-line))))
         (buffer (and token (gethash token agent-shell-nono--approval-sessions)))
         (payload (ignore-errors (json-parse-string body :object-type 'plist)))
         (request (and payload (map-elt payload :request))))
    (cond
     ((and token buffer (buffer-live-p buffer) request)
      (push (list :process connection :request request :buffer buffer)
            agent-shell-nono--approval-queue)
      (run-with-idle-timer 0 nil #'agent-shell-nono--approval-drain))
     (t
      (when token
        (remhash token agent-shell-nono--approval-sessions))
      (agent-shell-nono--approval-reply connection "{\"decision\":\"deny\"}")
      (message "agent-shell-nono: denied approval request for unknown session")))))

(defun agent-shell-nono--approval-reply (connection decision)
  "Answer nono on CONNECTION with DECISION (a JSON decision body)."
  (when (process-live-p connection)
    (condition-case nil
        (process-send-string
         connection
         (format (concat "HTTP/1.1 200 OK\r\n"
                         "Content-Type: application/json\r\n"
                         "Content-Length: %d\r\n"
                         "Connection: close\r\n\r\n"
                         "%s")
                 (length decision) decision))
      ;; The supervisor may already have timed out and closed the socket.
      (error nil))
    (ignore-errors (delete-process connection))))

(defun agent-shell-nono--approval-drain ()
  "Answer the next queued approval request when idle."
  (when (and (not agent-shell-nono--approval-active)
             agent-shell-nono--approval-queue)
    (agent-shell-nono--approval-ask
     (pop agent-shell-nono--approval-queue))))

(defun agent-shell-nono--remembered-p (buffer path access)
  "Non-nil when BUFFER already remembers an approval for PATH and ACCESS."
  (with-current-buffer buffer
    (member (cons path (downcase access))
            agent-shell-nono--remembered-approvals)))

(defun agent-shell-nono--approval-ask (entry)
  "Surface approval ENTRY as an approval prompt in its agent-shell session."
  (let* ((process (plist-get entry :process))
         (request (plist-get entry :request))
         (buffer (plist-get entry :buffer))
         (path (map-elt request :path))
         (access (or (map-elt request :access) "Read"))
         (answer
          (cond
           ;; nono already gave up and closed the connection.
           ((not (process-live-p process)) nil)
           ((not (buffer-live-p buffer)) ?n)
           ((agent-shell-nono--remembered-p buffer path access) ?a)
           (t
            (with-current-buffer buffer
              (when-let* ((window (get-buffer-window buffer 'visible)))
                (select-window window 'norecord))
              (ding)
              (read-char-from-minibuffer
               (format (concat "[nono:%s] allow %s access to %s (pid %s)? "
                               "y / n / a(lways for this session): ")
                       (buffer-name buffer) (downcase access) path
                       (or (map-elt request :child_pid) "?"))
               (list ?y ?n ?a)))))))
    (cond
     ((eq answer ?a)
      (when (buffer-live-p buffer)
        (with-current-buffer buffer
          (cl-pushnew (cons path (downcase access))
                      agent-shell-nono--remembered-approvals
                      :test #'equal)))
      (agent-shell-nono--approval-reply process "{\"decision\":\"grant\"}"))
     ((eq answer ?y)
      (agent-shell-nono--approval-reply process "{\"decision\":\"grant\"}"))
     (t
      (agent-shell-nono--approval-reply process "{\"decision\":\"deny\"}")))
    (run-with-idle-timer 0 nil #'agent-shell-nono--approval-drain)))

;;; Generated profiles.

(defun agent-shell-nono--profile-directory ()
  "Return the directory for generated profiles, creating it if needed."
  (let ((dir (expand-file-name agent-shell-nono-generated-profile-directory)))
    (unless (file-directory-p dir)
      (make-directory dir t))
    dir))

(defun agent-shell-nono--purge-dead-sessions ()
  "Drop approval-session registrations whose buffer is gone."
  (maphash (lambda (token buffer)
             (unless (buffer-live-p buffer)
               (remhash token agent-shell-nono--approval-sessions)))
           agent-shell-nono--approval-sessions))

(defun agent-shell-nono--prune-generated-profiles ()
  "Delete generated profile files untouched for more than a week."
  (let ((dir agent-shell-nono-generated-profile-directory))
    (when (file-directory-p dir)
      (dolist (file (directory-files dir t "agent-shell-.*\\.json\\'"))
        (let ((age (- (float-time)
                      (float-time
                       (file-attribute-modification-time
                        (file-attributes file))))))
          (when (> age (* 7 24 3600))
            (ignore-errors (delete-file file))))))))

(defun agent-shell-nono--remembered-grants ()
  "Turn remembered approvals into profile filesystem list entries."
  (let ((allow nil) (read nil) (read-file nil) (write nil) (write-file nil))
    (dolist (pair agent-shell-nono--remembered-approvals)
      (let ((path (car pair))
            (is-write (equal (cdr pair) "write")))
        (if (file-directory-p path)
            (if is-write (push path allow) (push path read))
          (if is-write (push path write-file) (push path read-file)))))
    (list :allow (vconcat allow) :read (vconcat read)
          :read_file (vconcat read-file)
          :write (vconcat write) :write_file (vconcat write-file))))

(defun agent-shell-nono--linux-overrides (approval-url ssh-socket)
  "Build the linux platform override for APPROVAL-URL and SSH-SOCKET."
  (let ((sockets
         (append
          (when (getenv "XDG_RUNTIME_DIR")
            (mapcar (lambda (socket-name)
                      (format "$XDG_RUNTIME_DIR/%s" socket-name))
                    agent-shell-nono-wayland-sockets))
          (when ssh-socket (list ssh-socket))))
        (set-vars (list))
        overrides)
    (when sockets
      (setq overrides
            (append overrides (list :filesystem
                                    (list :unix_socket
                                          (vconcat sockets))))))
    (when agent-shell-nono-block-x11
      ;; /tmp is writable and Landlock cannot deny /tmp/.X11-unix
      ;; inside it, so blind the X11 socket through the environment.
      (setq set-vars
            (append set-vars
                    (list :DISPLAY "nono-x11-blocked.invalid:0"
                          :XAUTHORITY "/dev/null"))))
    (when ssh-socket
      (setq set-vars
            (append set-vars
                    (list
                     :SSH_AUTH_SOCK ssh-socket
                     :GIT_SSH_COMMAND
                     (concat "/usr/bin/ssh -F /dev/null"
                               " -o IdentityFile=none -o BatchMode=yes"
                               " -o StrictHostKeyChecking=yes"
                               " -o ForwardAgent=no"
                               " -o UpdateHostKeys=no")))))
    (when set-vars
      (setq overrides
            (append overrides
                    (list :environment (list :set_vars set-vars)))))
    (when approval-url
      (setq overrides
            (append
             overrides
             (list :security
                   `(:capability_elevation t
                     :approval_backends
                     (:agent-shell (:type "webhook" :url ,approval-url
                                          :timeout_secs
                                          ,agent-shell-nono-approval-timeout-secs))
                     :approval_defaults (:backend "agent-shell"))))))
    overrides))

(defun agent-shell-nono--profile-spec (approval-url ssh-socket)
  "Build the nono profile spec for APPROVAL-URL and SSH-SOCKET."
  (let* ((extra (agent-shell-nono--remembered-grants))
         (linux (agent-shell-nono--linux-overrides approval-url ssh-socket)))
    (append
     (list
      :extends "default"
      :meta (list :name "agent-shell-session"
                  :description
                  "Generated agent-shell sandbox: system tools readable, X11 denied, Wayland allowed")
      :workdir (list :access "readwrite")
      :network (append
                (list :block (if agent-shell-nono-network-block t :false))
                (when agent-shell-nono-allow-domains
                  (list :allow_domain
                        (vconcat agent-shell-nono-allow-domains))))
      :security (list :wsl2_proxy_policy "error")
      :filesystem (list
                   :allow (vconcat agent-shell-nono-workspace-write-paths
                                   (plist-get extra :allow))
                   :read (vconcat agent-shell-nono-system-read-paths
                                  agent-shell-nono-user-read-paths
                                  (plist-get extra :read))
                   :read_file (vconcat agent-shell-nono-read-file-paths
                                      '("$HOME/.ssh/known_hosts")
                                      (plist-get extra :read_file))
                   :write (plist-get extra :write)
                   :write_file (plist-get extra :write_file)
                   :deny (vconcat agent-shell-nono-extra-deny-paths)
                   :bypass_protection
                   (vconcat agent-shell-nono-bypass-protection-paths))
      )
     (when linux (list :platform_overrides (list :linux linux)))
     (when agent-shell-nono-allow-gpu (list :allow_gpu t)))))

(defun agent-shell-nono--generate-profile ()
  "Write the profile for the current agent buffer; return its path.
Regenerated on every launch so customizations and remembered
approvals take effect on the next launch of a session."
  (let* ((dir (agent-shell-nono--profile-directory))
         (name (format "agent-shell-%d-%d" (emacs-pid)
                       (cl-incf agent-shell-nono--launch-counter)))
         (file (expand-file-name (format "%s.json" name) dir))
         (approval-url
          (when (agent-shell-nono--elevation-available-p)
            (format "http://127.0.0.1:%d/approve/%s"
                    (agent-shell-nono--approval-server)
                    (agent-shell-nono--session-token-ensure))))
         (ssh-socket
          (when (and agent-shell-nono-ssh-agent
                     (agent-shell-nono--native-linux-p))
            (agent-shell-nono--ensure-ssh-agent)))
         (spec (agent-shell-nono--profile-spec approval-url ssh-socket)))
    (with-temp-file file
      (insert (json-serialize spec) "\n"))
    (setq agent-shell-nono--session-profile-file file)
    file))

;;; Launch.

;;;###autoload
(defun agent-shell-nono-command-prefix (buffer)
  "Return the nono launch prefix for agent BUFFER.
Generates the session profile, applies nono-enforced resource limits
(Linux), and wraps the command with `nono run'.  Remote processes are
left unwrapped.  A missing nono binary is an error."
  (with-current-buffer buffer
    (if (file-remote-p default-directory)
        (progn
          (message "The nono prefix supports local agent processes only")
          nil)
      (when agent-shell-nono-enabled
        (let ((nono (or (executable-find "nono")
                        (user-error
                         "Nono is required; install it, e.g. `mise use -g nono@latest'")))
              (profile (agent-shell-nono--generate-profile)))
          (append
           (list nono "--silent" "run"
                 "--profile" profile
                 "--workdir" (expand-file-name default-directory)
                 "--allow-cwd")
           (when (agent-shell-nono--native-linux-p)
             (append
              (when-let* ((memory (agent-shell-nono--memory-arg)))
                (list "--memory" memory))
              (when agent-shell-nono-max-processes
                (list "--max-processes"
                      (number-to-string agent-shell-nono-max-processes)))))
           (list "--no-rollback" "--no-rollback-prompt"
                 "--startup-timeout" "0" "--")))))))

(defun agent-shell-nono--cleanup-buffer ()
  "Remove this buffer's generated profile and approval registration."
  (when agent-shell-nono--session-token
    (remhash agent-shell-nono--session-token
             agent-shell-nono--approval-sessions))
  (when (and agent-shell-nono--session-profile-file
             (file-exists-p agent-shell-nono--session-profile-file))
    (ignore-errors (delete-file agent-shell-nono--session-profile-file))))

;;;###autoload
(define-minor-mode agent-shell-nono-mode
  "Launch agents with nono using per-session generated profiles."
  :global t
  :lighter " AS-Nono"
  :group 'agent-shell-utils
  (if agent-shell-nono-mode
      (progn
        (unless (eq agent-shell-command-prefix #'agent-shell-nono-command-prefix)
          (setq agent-shell-nono--previous-command-prefix agent-shell-command-prefix
                agent-shell-command-prefix #'agent-shell-nono-command-prefix))
        (add-hook 'kill-buffer-hook #'agent-shell-nono--cleanup-buffer)
        (agent-shell-nono--prune-generated-profiles)
        (agent-shell-nono--purge-dead-sessions))
    (when (eq agent-shell-command-prefix #'agent-shell-nono-command-prefix)
      (setq agent-shell-command-prefix agent-shell-nono--previous-command-prefix))
    (remove-hook 'kill-buffer-hook #'agent-shell-nono--cleanup-buffer)
    (when (and agent-shell-nono--approval-server
               (process-live-p agent-shell-nono--approval-server))
      (delete-process agent-shell-nono--approval-server))
    (setq agent-shell-nono--approval-server nil
          agent-shell-nono--approval-port nil)))

(provide 'agent-shell-nono)

